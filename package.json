{
  "name": "tollai-poc",
  "version": "1.0.0",
  "description": "TollAI - Cognitive Toll Protocol PoC for Autonomous AI Agent Defense",
  "main": "server.js",
  "exports": {
    ".": "./server.js"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "server.js",
    "lib/",
    "public/",
    "test/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/username/tollai-poc"
  },
  "bugs": {
    "url": "https://github.com/username/tollai-poc/issues"
  },
  "homepage": "https://github.com/username/tollai-poc#readme",
  "scripts": {
    "start": "node server.js",
    "config": "node attacker-config.js",
    "attack": "node attackers/agent-simulator.js",
    "test": "node attackers/agent-simulator.js --all",
    "test:flows": "node test/toll-flows.js",
    "test:client": "node test/toll-client.js",
    "test:unit": "node --test \"tollai/test/**/*.test.js\"",
    "test:all": "npm run test:unit && npm run test:flows && npm run test:client && npm test",
    "test:load": "node test/load-test.js",
    "stop": "lsof -ti:3000,3001 | xargs kill -9 2>/dev/null; echo '✅ Servers stopped (ports 3000, 3001)'"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "express": "^4.18.2"
  },
  "keywords": [
    "cybersecurity",
    "ai-defense",
    "cognitive-toll",
    "anti-bot",
    "autonomous-agents"
  ],
  "author": "Cybersecurity Architect",
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
